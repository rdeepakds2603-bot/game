{
  "name": "the-final-sunset",
  "version": "1.0.0",
  "description": "The Final Sunset - Cinematic Anime Story Game (Mobile & Android APK Edition)",
  "scripts": {
    "start": "node local-server.js",
    "cap:add:android": "npx @capacitor/cli add android",
    "cap:sync": "npx @capacitor/cli sync",
    "cap:open": "npx @capacitor/cli open android",
    "cap:build": "npx @capacitor/cli copy && npx @capacitor/cli sync android"
  },
  "keywords": ["game", "anime", "story", "android", "apk", "pwa", "capacitor"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  }
}
